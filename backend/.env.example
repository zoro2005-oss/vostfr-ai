DATABASE_URL=postgresql+psycopg://user:password@localhost:5433/vostfr_ai
SECRET_KEY=change-this-to-a-very-long-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256
UPLOAD_DIR=./storage
MAX_UPLOAD_SIZE=10737418240
# Suppression automatique (vidéo + sous-titres + entrée en base) après génération.
# 0 = désactive le nettoyage automatique.
FILE_RETENTION_HOURS=2
CLEANUP_INTERVAL_MINUTES=10
# Délai de grâce avant suppression d'un fichier présent sur le disque mais absent de la base.
ORPHAN_FILE_GRACE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
# Compte promu super administrateur au démarrage (inscrivez d'abord cet email).
ADMIN_EMAIL=
TRANSCRIPTION_PROVIDER=groq
TRANSLATION_PROVIDER=groq
TRANSLATION_API_KEY=
TRANSLATION_API_URL=
WHISPER_MODEL=small
GROQ_API_KEY=
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_TRANSLATION_MODEL=openai/gpt-oss-120b
GROQ_MAX_AUDIO_BYTES=25165824
GROQ_AUDIO_CHUNK_SECONDS=300

# Réinitialisation de mot de passe par email
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_EXPIRE_MINUTES=30
# true = renvoie le lien de reset dans la réponse API quand SMTP_HOST est vide (dev uniquement)
EXPOSE_RESET_URL=false
# Laisser SMTP_HOST vide en local : le lien de réinitialisation sera écrit dans les logs backend.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@vostfr.ai
SMTP_TLS=true
